# Prior Labs API token, needed to run TabPFN-3.5 (notebooks, quickstart).
# Keys are issued at: https://ux.priorlabs.ai/account
TABPFN_TOKEN=your-api-key-here

# --- Web map (web_map/) ---
# Earth Engine service account. Put the real values only in .env, which is not committed.
SERVICE_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PROJECT_ID=your-cloud-project-id

# Earth Engine assets the map reads; the service account needs read access.
# Upload the class map with pyramiding policy MODE, or zoomed-out views show wrong classes.
PREDICTED_CLASSCODE=projects/carbon-monitoring-471820/assets/TABPFN/predicted_classcode
PREDICTED_CONFIDENCE=projects/carbon-monitoring-471820/assets/TABPFN/predicted_confidence
